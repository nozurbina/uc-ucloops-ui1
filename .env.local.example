# Server-side only — NOT prefixed with VITE_, so it is never bundled into
# the browser. Only the /api/chat serverless function reads this.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Any random long string — used to sign the per-conversation turn counter
# so the message limit can't be tampered with client-side.
# Generate one with: openssl rand -hex 32
CHAT_SESSION_SECRET=replace-with-a-long-random-string

# Shared password for the demo. Unset = no gate (anyone can use it).
# Colleagues type this once; it's then remembered for 30 days.
DEMO_PASSWORD=

# OPTIONAL — hard ceiling on model calls per UTC day across ALL visitors.
# This is the cost backstop that doesn't depend on any provider spend limit.
# A call averages ~2-3 cents, so 300/day bounds a day at roughly $6-9.
# Requires the Upstash vars below. Default 300 if unset.
DEMO_DAILY_CALL_CAP=300

# OPTIONAL — per-IP usage cap over a rolling 3-day window.
# Without these, the demo still enforces the per-conversation limit and the
# httpOnly cookie (which survives a page refresh), but someone using a fresh
# incognito window gets a fresh allowance. Add an Upstash Redis database
# (free tier is ample) and paste its REST credentials here to close that gap.
# Leave blank to skip — the code checks for these and fails open if absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
